// Cloudflare Workers config for finaiw.com. The site is built by
// .github/workflows/cloudflare.yml (npm run build:cloudflare) and deployed
// from there; see cloudflare/worker.mjs for what the script itself does.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finaiw",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-01",
  // The api/ handlers use process.env and the Resend SDK.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Prerendered routes exist as /route.html and /route/index.html;
    // unknown paths fall back to index.html, same as the SPA always has.
    "not_found_handling": "single-page-application",
    // Only these paths run the Worker. Everything else is a static asset
    // and never touches the free plan's daily Worker request quota.
    "run_worker_first": ["/api/*", "/net-worth-percentile/share"]
  },
  // workers.dev and per-version preview URLs back the PR previews.
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true }
}
