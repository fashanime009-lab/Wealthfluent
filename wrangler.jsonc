// Cloudflare Workers config for finaiw.com. The site is built by
// .github/workflows/cloudflare.yml (npm run build:cloudflare) and deployed
// from there; see cloudflare/worker.mjs for what the script itself does.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finaiw",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-01",
  // The api/ handlers use process.env and the Resend SDK.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Every app route is prerendered (/route.html and /route/index.html),
    // so anything else is a real 404: dist/404.html (the app's "Page not
    // found" page, noindex) served with status 404. The old SPA fallback
    // answered every unknown path with the home page and a 200, which
    // Google saw as endless soft-404 duplicates.
    "not_found_handling": "404-page",
    // Only these paths run the Worker. Everything else is a static asset
    // and never touches the free plan's daily Worker request quota.
    "run_worker_first": ["/api/*", "/net-worth-percentile/share"]
  },
  // workers.dev and per-version preview URLs back the PR previews.
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true }
}
