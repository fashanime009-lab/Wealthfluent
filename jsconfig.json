{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/app/*": ["src/app/*"],
      "@/journeys/*": ["src/journeys/*"],
      "@/shared/*": ["src/shared/*"],
      "@/components/*": ["src/components/*"],
      "@/services/*": ["src/services/*"],
      "@/hooks/*": ["src/hooks/*"],
      "@/utils/*": ["src/utils/*"],
      "@/context/*": ["src/context/*"]
    }
  },
  "exclude": [
    "node_modules",
    "dist"
  ]
}